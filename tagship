#!/bin/bash
# Tagship CLI — manage your deploy pipeline
# Usage: tagship <command> [args]
set -e

TAGSHIP_DIR="/opt/stacks/tagship"
DEPLOY_SH="$TAGSHIP_DIR/scripts/deploy.sh"
STACKS_DIR="/opt/stacks"

case "${1:-help}" in
  add)
    # tagship add chrisribe/mood-tube
    REPO=$2
    if [ -z "$REPO" ]; then
      echo "Usage: tagship add <user/repo>"
      exit 1
    fi
    
    # Validate format: must be user/repo
    if [[ ! "$REPO" =~ ^[a-zA-Z0-9_.-]+/[a-zA-Z0-9_.-]+$ ]]; then
      echo "❌ Invalid format: '$REPO'"
      echo "   Must be: user/repo (e.g. chrisribe/mood-tube)"
      exit 1
    fi
    
    # Check for duplicate
    if grep -q "\"$REPO\"" "$DEPLOY_SH"; then
      echo "⚠️  '$REPO' is already registered"
      exit 0
    fi
    
    REPO_NAME=$(echo "$REPO" | cut -d'/' -f2)
    DEPLOY_PATH="$STACKS_DIR/$REPO_NAME"
    
    # Clone if not exists
    if [ ! -d "$DEPLOY_PATH" ]; then
      echo "📥 Cloning $REPO to $DEPLOY_PATH..."
      git clone "git@github.com:${REPO}.git" "$DEPLOY_PATH"
    else
      echo "📂 $DEPLOY_PATH already exists"
    fi
    
    # Add to REPO_PATHS
    sed -i "/^)/i\\  [\"$REPO\"]=\"$DEPLOY_PATH\"" "$DEPLOY_SH"
    echo "✅ Added to deploy.sh"
    
    TOKEN=$(grep -oP '(?<=DEPLOY_TOKEN=).+' "$TAGSHIP_DIR/.env")
    
    echo ""
    echo "✅ Registered on server!"
    echo ""
    echo "Now run on your dev machine:"
    echo "────────────────────────────────────────────────"
    echo "  cd $REPO_NAME"
    echo "  mkdir -p .github/workflows"
    echo "  curl -sL https://raw.githubusercontent.com/chrisribe/tagship/main/deploy.yml > .github/workflows/deploy.yml"
    echo "  git add .github/workflows && git commit -m \"Add tagship deploy\" && git push"
    echo "────────────────────────────────────────────────"
    echo ""
    echo "Then add this secret to $REPO on GitHub:"
    echo "  Settings → Secrets → Actions → New secret"
    echo "  Name:  DEPLOY_TOKEN"
    echo "  Value: $TOKEN"
    echo ""
    echo "Deploy with: git tag v1.0.0 && git push --tags"
    ;;
    
  remove)
    REPO=$2
    if [ -z "$REPO" ]; then
      echo "Usage: tagship remove <user/repo>"
      exit 1
    fi
    sed -i "/\"$REPO\"/d" "$DEPLOY_SH"
    echo "✅ Removed $REPO from deploy.sh (files untouched)"
    ;;
    
  list)
    echo "📋 Registered repos:"
    grep -oP '"\K[^"]+(?="\]=)' "$DEPLOY_SH" | while read -r repo; do
      path=$(grep "$repo" "$DEPLOY_SH" | grep -oP '="\K[^"]+')
      if [ -d "$path" ]; then
        echo "  ✅ $repo → $path"
      else
        echo "  ❌ $repo → $path (missing!)"
      fi
    done
    ;;
    
  status)
    echo "⚓ Tagship Status"
    echo ""
    docker ps --filter "name=tagship" --format "  Container: {{.Names}} | {{.Status}}"
    echo ""
    echo "Recent deploys:"
    docker logs tagship --tail 10 2>&1 | grep -i "deploy\|done\|error" || echo "  (none)"
    ;;
    
  logs)
    docker logs tagship --tail "${2:-50}" -f
    ;;
    
  token)
    TOKEN=$(grep -oP '(?<=DEPLOY_TOKEN=).+' "$TAGSHIP_DIR/.env")
    echo ""
    echo "Add this to each repo on GitHub:"
    echo "  Settings → Secrets → Actions → New repository secret"
    echo ""
    echo "  Name:  DEPLOY_TOKEN"
    echo "  Value: $TOKEN"
    echo ""
    ;;
    
  test)
    # Self-test: POST to local webhook to verify token + config
    TOKEN=$(grep -oP '(?<=DEPLOY_TOKEN=).+' "$TAGSHIP_DIR/.env")
    REPO=${2:-"chrisribe/tagship"}
    echo "🧪 Testing webhook with repo=$REPO tag=test-dry-run..."
    RESPONSE=$(curl -s -o /dev/null -w "%{http_code}" -X POST http://localhost:9000/hooks/deploy \
      -H "Content-Type: application/json" \
      -H "Authorization: Bearer $TOKEN" \
      -d "{\"repo\":\"$REPO\",\"tag\":\"test-dry-run\"}")
    if [ "$RESPONSE" = "200" ]; then
      echo "✅ Token valid, webhook triggered (check logs for dry-run result)"
    else
      echo "❌ Failed — HTTP $RESPONSE"
      echo "   Check: tagship token matches what the container sees"
      echo "   Try: tagship restart (rebuilds with latest .env)"
    fi
    ;;
    
  restart)
    cd "$TAGSHIP_DIR"
    docker compose -f docker-compose.webhook.yml up -d --build
    echo "✅ Restarted"
    ;;
    
  version)
    cd "$TAGSHIP_DIR"
    TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "untagged")
    HASH=$(git rev-parse --short HEAD)
    echo "tagship $TAG ($HASH)"
    ;;
    
  versions)
    echo "📋 Deployed versions:"
    grep -oP '"\K[^"]+(?="\]=)' "$DEPLOY_SH" | while read -r repo; do
      path=$(grep "\"$repo\"" "$DEPLOY_SH" | grep -oP '="\K[^"]+')
      if [ -d "$path/.git" ]; then
        ver=$(cd "$path" && git describe --tags --exact-match 2>/dev/null || cd "$path" && git rev-parse --short HEAD)
        echo "  $repo → $ver"
      else
        echo "  $repo → (not cloned)"
      fi
    done
    ;;
    
  *)
    echo "⚓ Tagship — tag it, ship it"
    echo ""
    echo "Usage: tagship <command>"
    echo ""
    echo "Commands:"
    echo "  add <user/repo>     Register a repo for auto-deploy"
    echo "  remove <user/repo>  Unregister a repo"
    echo "  list                Show registered repos"
    echo "  status              Container + recent deploys"
    echo "  logs [n]            Tail deploy logs"
    echo "  token               Show deploy token"
    echo "  test [user/repo]    Test webhook locally (verifies token works)"
    echo "  restart             Rebuild & restart webhook"
    echo "  version             Show tagship version"
    echo "  versions            Show deployed app versions"
    ;;
esac
