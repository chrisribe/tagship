[
  {
    "id": "deploy",
    "execute-command": "/scripts/deploy.sh",
    "command-working-directory": "/scripts",
    "pass-arguments-to-command": [
      {
        "source": "payload",
        "name": "repo"
      },
      {
        "source": "payload",
        "name": "tag"
      }
    ],
    "trigger-rule": {
      "match": {
        "type": "value",
        "value": "Bearer ${DEPLOY_TOKEN}",
        "parameter": {
          "source": "header",
          "name": "Authorization"
        }
      }
    }
  }
]
